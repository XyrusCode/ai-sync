# ai-sync — PUBLIC repo. Never commit user data, paths, or secrets.

# Local machine config (real paths / enable flags) — user creates from example
config.local.yaml
config.local.yml

# Secrets / env
.env
*.env
secrets*.yaml
secrets*.json

# Runtime data hub (must never be committed)
.ai-sync/
data/
backups/
