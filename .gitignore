*.db
*.db-wal
*.db-shm
*.vscdb
*.vscdb-wal
*.vscdb-shm
*.pb
*.pbtxt
*.jsonl

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
*.egg-info/
build/
dist/
