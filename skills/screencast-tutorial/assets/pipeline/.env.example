# Copy to .env and fill in. NEVER commit .env.
# Any config value may reference these as ${ENV:VAR_NAME}.

# Credentials for the login form, and for token minting when configured.
LOGIN_ID=
LOGIN_PASSWORD=

# Optional: a specific Chromium binary instead of the Playwright default.
# CHROMIUM_PATH=

# Watch the recording live instead of headless. Useful for a first take.
# PLAYWRIGHT_HEADLESS=false

# Per-action delay in ms. Set ~300 when the target app animates heavily.
# PLAYWRIGHT_SLOWMO=0

# Abort a take when a settle gate fails, instead of logging and continuing.
# STRICT_GATES=true

# Narration synthesis. Free Edge neural voices, no API key.
#   en-US-AriaNeural / en-US-GuyNeural / en-GB-SoniaNeural / en-NG-EzinneNeural
# TTS_MAX_RETRIES=4
# TTS_RETRY_DELAY_MS=2000

# Cap the silent lead-in before narration, ms. Prevents a slow spinner eating a clip.
# MAX_LEAD_MS=2500

# YouTube publishing (optional). OAuth 2.0 "Desktop app" client.
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_OAUTH_PORT=4173
