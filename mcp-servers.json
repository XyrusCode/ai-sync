{
  "servers": [
    {
      "name": "sentry",
      "type": "stdio",
      "command": "npx",
      "args": [
        "@modelcontextprotocol/server-sentry"
      ],
      "env": {
        "SENTRY_API_KEY": "{{ env.SENTRY_API_KEY }}"
      },
      "tools": [
        "claude"
      ],
      "notes": "Sentry error tracking integration (Claude only)"
    },
    {
      "name": "playwright",
      "type": "stdio",
      "command": "npx",
      "args": [
        "@modelcontextprotocol/server-playwright"
      ],
      "env": {},
      "tools": [
        "codex"
      ],
      "notes": "Browser automation (Codex extension mode only)"
    },
    {
      "name": "graphify",
      "type": "stdio",
      "command": "graphify-mcp",
      "args": [],
      "env": {},
      "tools": [
        "claude",
        "codex",
        "gemini",
        "kiro",
        "cursor",
        "opencode"
      ],
      "notes": "Code knowledge graph and architecture query server (graphify)"
    },
    {
      "name": "omniroute",
      "type": "stdio",
      "command": "omniroute",
      "args": [
        "--mcp"
      ],
      "env": {},
      "tools": [
        "claude",
        "codex",
        "gemini",
        "kiro",
        "cursor",
        "opencode"
      ],
      "notes": "Unified AI routing gateway with 352 providers and token compression"
    }
  ]
}
